<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(TransportIn.Components.Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(TransportIn.Components.Layout.AdminLayout)">
            <div class="login-page">
                <div class="login-card text-center">
                    <div class="login-header">
                        <i class="bi bi-exclamation-triangle-fill" style="color: var(--danger-red); font-size: 4rem;"></i>
                        <h2 style="color: var(--text-primary);">Помилка 404</h2>
                        <p style="color: var(--text-secondary);">Вибачте, але такої сторінки не існує</p>
                    </div>
                    <a href="/" class="btn-modern btn-add" style="text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem;">
                        <i class="bi bi-house-door"></i> Повернутися на сторінку входу
                    </a>
                </div>
            </div>
        </LayoutView>
    </NotFound>
</Router>