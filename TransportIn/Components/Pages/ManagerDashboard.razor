@page "/manager-dashboard"
@rendermode InteractiveServer

@inject TransportIn.Services.AuthService AuthService
@inject TransportIn.Services.OrderService OrderService
@inject TransportIn.Services.IVehicleService VehicleService
@inject NavigationManager Navigation

<div class="container-fluid mt-3">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Кабінет Менеджера: @AuthService.CurrentUser?.FullName</h2>
        <button class="btn btn-outline-danger btn-sm" @onclick="Logout">
            Вийти
        </button>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="row">

        <!-- Створення замовлення -->
        <div class="col-md-5">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">📦 Створення нового замовлення</h5>
                </div>

                <div class="card-body">

                    <div class="mb-3">
                        <label class="form-label">Компанія-замовник</label>
                        <input type="text" class="form-control"
                               @bind="newOrder.CustomerCompany"
                               placeholder="ТОВ 'Приклад'" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Ім'я контактної особи та телефон</label>
                        <div class="input-group">
                            <input type="text" class="form-control"
                                   @bind="newOrder.CustomerName"
                                   placeholder="Ім'я" />

                            <input type="text" class="form-control"
                                   @bind="newOrder.CustomerPhone"
                                   placeholder="0501234567" />
                        </div>
                    </div>

                    <hr />
                    <h6>Характеристики вантажу</h6>

                    <div class="mb-3">
                        <label class="form-label">Назва вантажу</label>
                        <input type="text" class="form-control"
                               @bind="newOrder.CargoName"
                               placeholder="Продукти харчування" />
                    </div>

                    <div class="row mb-3">
                        <div class="col">
                            <label class="form-label">Вага (т)</label>
                            <input type="number" step="0.1"
                                   class="form-control"
                                   @bind="newOrder.WeightTons" />
                        </div>

                        <div class="col">
                            <label class="form-label">Об'єм (м³)</label>
                            <input type="number" step="1"
                                   class="form-control"
                                   @bind="newOrder.VolumeM3" />
                        </div>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input"
                               id="refCheck"
                               @bind="newOrder.RequiresRefrigerator" />

                        <label class="form-check-label" for="refCheck">
                            Потребує рефрижератора
                        </label>
                    </div>

                    <hr />

                    <!-- Пункти завантаження -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Пункти завантаження</label>

                        @for (int i = 0; i < newOrder.LoadingPoints.Count; i++)
                        {
                            var index = i;

                            <div class="input-group mb-2">
                                <input type="text" class="form-control"
                                       @bind="newOrder.LoadingPoints[index]"
                                       placeholder="Адреса завантаження" />

                                <button class="btn btn-outline-danger"
                                        type="button"
                                        @onclick="() => RemoveLoadingPoint(index)">
                                    X
                                </button>
                            </div>
                        }

                        <button class="btn btn-sm btn-outline-secondary"
                                @onclick="AddLoadingPoint">
                            + Додати точку завантаження
                        </button>
                    </div>

                    <!-- Пункти доставки -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Пункти доставки</label>

                        @for (int i = 0; i < newOrder.DeliveryPoints.Count; i++)
                        {
                            var index = i;

                            <div class="input-group mb-2">
                                <input type="text" class="form-control"
                                       @bind="newOrder.DeliveryPoints[index]"
                                       placeholder="Адреса доставки" />

                                <button class="btn btn-outline-danger"
                                        type="button"
                                        @onclick="() => RemoveDeliveryPoint(index)">
                                    X
                                </button>
                            </div>
                        }

                        <button class="btn btn-sm btn-outline-secondary"
                                @onclick="AddDeliveryPoint">
                            + Додати точку доставки
                        </button>
                    </div>

                    <button class="btn btn-success w-100 mt-2"
                            @onclick="CreateOrder"
                            disabled="@isSaving">
                        @(isSaving ? "Збереження..." : "Створити замовлення")
                    </button>
                </div>
            </div>
        </div>

        <!-- Список замовлень -->
        <div class="col-md-7">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">📋 Активні замовлення та підбір транспорту</h5>
                </div>

                <div class="card-body">

                    @if (isLoading)
                    {
                        <p class="text-muted">Завантаження замовлень...</p>
                    }
                    else if (orders.Count == 0)
                    {
                        <p class="text-muted">Ще немає створених замовлень.</p>
                    }
                    else
                    {
                        @foreach (var order in orders)
                        {
                            <div class="card mb-3 border-secondary">
                                <div class="card-body">

                                    <h5 class="card-title">
                                        Замовлення №@order.Id: @order.CargoName
                                    </h5>

                                    <p class="mb-1">
                                        <strong>Замовник:</strong>
                                        @order.CustomerCompany
                                        (@order.CustomerName, @order.CustomerPhone)
                                    </p>

                                    <p class="mb-1">
                                        <strong>Параметри:</strong>
                                        Вага: @order.WeightTons т |
                                        Об'єм: @order.VolumeM3 м³ |
                                        Рефрижератор:
                                        @(order.RequiresRefrigerator ? "Так" : "Ні")
                                    </p>

                                    <p class="mb-1 text-primary">
                                        <strong>Звідки:</strong>
                                        @string.Join(" ➔ ", order.LoadingPoints)
                                    </p>

                                    <p class="mb-2 text-success">
                                        <strong>Куди:</strong>
                                        @string.Join(" ➔ ", order.DeliveryPoints)
                                    </p>

                                    <p class="mb-2">
                                        <strong>Призначений транспорт:</strong>
                                        <span class="badge bg-info text-dark">
                                            @order.AssignedVehiclePlate
                                        </span>
                                    </p>

                                    <p class="mb-2">
                                        <strong>Статус:</strong>
                                        <span class="badge bg-warning text-dark">
                                            @order.Status
                                        </span>
                                    </p>

                                    <button class="btn btn-sm btn-outline-primary"
                                            @onclick="() => SelectOrderForMatching(order)">
                                        🔍 Підібрати транспорт автоматично
                                    </button>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Підбір автомобілів -->
            @if (selectedOrderForMatching != null)
            {
                <div class="card shadow-sm mt-4 border-primary">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            Рекомендовані авто для замовлення №@selectedOrderForMatching.Id
                        </h5>
                    </div>

                    <div class="card-body">

                        @{
                            var suitableVehicles = OrderService.GetSuitableVehicles(
                            selectedOrderForMatching,
                            vehicles);
                        }

                        @if (!suitableVehicles.Any())
                        {
                            <div class="alert alert-danger mb-0">
                                Не знайдено автомобілів, які відповідають вимогам
                                за вантажопідйомністю, об'ємом чи обладнанням.
                            </div>
                        }
                        else
                        {
                            <table class="table table-sm table-hover">
                                <thead>
                                    <tr>
                                        <th>Модель</th>
                                        <th>Номер</th>
                                        <th>Вантажопідйомність</th>
                                        <th>Об'єм</th>
                                        <th>Реф.</th>
                                        <th>Дія</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var veh in suitableVehicles)
                                    {
                                        <tr>
                                            <td>@veh.BrandModel</td>
                                            <td>@veh.LicensePlate</td>
                                            <td>@veh.CapacityTons т</td>
                                            <td>@veh.VolumeM3 м³</td>
                                            <td>@(veh.HasRefrigerator ? "Так" : "Ні")</td>
                                            <td>
                                                <button class="btn btn-sm btn-success"
                                                        @onclick="() => AssignVehicle(selectedOrderForMatching.Id, veh.LicensePlate)"
                                                        disabled="@isSaving">
                                                    Призначити
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private TransportIn.Models.Order newOrder = CreateEmptyOrder();

    private TransportIn.Models.Order? selectedOrderForMatching;

    private List<TransportIn.Models.Order> orders = new();

    private List<TransportIn.Models.Vehicle> vehicles = new();

    private bool isLoading = true;
    private bool isSaving = false;
    private string errorMessage = "";

    private static TransportIn.Models.Order CreateEmptyOrder()
    {
        return new TransportIn.Models.Order
        {
            LoadingPoints = new() { "" },
            DeliveryPoints = new() { "" }
        };
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;

        try
        {
            orders = await OrderService.GetAllOrdersAsync();
            vehicles = await VehicleService.GetAllVehiclesAsync();
            errorMessage = "";
        }
        catch (Exception ex)
        {
            errorMessage = "Помилка завантаження даних: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void AddLoadingPoint()
    {
        newOrder.LoadingPoints.Add("");
    }

    private void RemoveLoadingPoint(int index)
    {
        if (newOrder.LoadingPoints.Count > 1)
            newOrder.LoadingPoints.RemoveAt(index);
    }

    private void AddDeliveryPoint()
    {
        newOrder.DeliveryPoints.Add("");
    }

    private void RemoveDeliveryPoint(int index)
    {
        if (newOrder.DeliveryPoints.Count > 1)
            newOrder.DeliveryPoints.RemoveAt(index);
    }

    private async Task CreateOrder()
    {
        if (string.IsNullOrWhiteSpace(newOrder.CustomerCompany) ||
            string.IsNullOrWhiteSpace(newOrder.CargoName))
        {
            errorMessage = "Заповніть компанію-замовника та назву вантажу.";
            return;
        }

        if (isSaving)
            return;

        isSaving = true;
        errorMessage = "";

        try
        {
            newOrder.LoadingPoints = newOrder.LoadingPoints
                .Where(p => !string.IsNullOrWhiteSpace(p))
                .ToList();

            newOrder.DeliveryPoints = newOrder.DeliveryPoints
                .Where(p => !string.IsNullOrWhiteSpace(p))
                .ToList();

            await OrderService.AddOrderAsync(newOrder);

            newOrder = CreateEmptyOrder();

            orders = await OrderService.GetAllOrdersAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "Помилка створення замовлення: " + ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void SelectOrderForMatching(TransportIn.Models.Order order)
    {
        selectedOrderForMatching = order;
        errorMessage = "";
    }

    private async Task AssignVehicle(int orderId, string plate)
    {
        if (isSaving)
            return;

        isSaving = true;
        errorMessage = "";

        try
        {
            await OrderService.AssignVehicleAsync(orderId, plate);

            orders = await OrderService.GetAllOrdersAsync();

            selectedOrderForMatching = null;
        }
        catch (Exception ex)
        {
            errorMessage = "Помилка призначення транспорту: " + ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Logout()
    {
        AuthService.Logout();
        Navigation.NavigateTo("/");
    }
}
