@page "/manager-dashboard"
@layout TransportIn.Components.Layout.AdminLayout
@rendermode InteractiveServer
@inject TransportIn.Services.AuthService AuthService
@inject TransportIn.Services.OrderService OrderService
@inject TransportIn.Services.FleetService FleetService
@implements IDisposable
@inject NavigationManager Navigation

<div class="admin-layout">
    <!-- ===== САЙДБАР ===== -->
    <aside class="admin-sidebar">
        <div class="sidebar-header">
            <h4><i class="bi bi-truck-front-fill"></i> TransportIn</h4>
            <small>Диспетчерський пульт</small>
        </div>
        <nav class="mt-3">
            <a class="nav-link" href="/admin-dashboard">
                <i class="bi bi-grid-1x2-fill"></i> Панель адміна
            </a>
            <a class="nav-link active" href="/manager-dashboard">
                <i class="bi bi-people-fill"></i> Менеджер
            </a>
            <a class="nav-link" href="/driver-dashboard">
                <i class="bi bi-person-badge-fill"></i> Водій
            </a>
            <a class="nav-link" href="/counter">
                <i class="bi bi-graph-up-arrow"></i> Аналітика
            </a>
        </nav>
    </aside>

    <!-- ===== ОСНОВНИЙ КОНТЕНТ ===== -->
    <main class="admin-main">
        <!-- Верхня панель -->
        <div class="top-navbar">
            <div>
                <h5 class="mb-0" style="font-weight: 600; color: var(--text-primary);">Кабінет Менеджера</h5>
                <small style="color: var(--text-secondary);">@AuthService.CurrentUser?.FullName</small>
            </div>
            <div class="user-info">
                <button class="btn-logout" @onclick="Logout">
                    <i class="bi bi-box-arrow-right"></i> <span class="d-none d-sm-inline">Вийти</span>
                </button>
            </div>
        </div>

        <div class="content-section">
            <div class="row g-4">
                <!-- Ліва колонка: Створення замовлення -->
                <div class="col-lg-5">
                    <div class="modern-card">
                        <div class="card-header-custom">
                            <h5>
                                <span class="header-icon blue"><i class="bi bi-box-seam"></i></span>
                                Створення нового замовлення
                            </h5>
                        </div>
                        <div class="card-body-custom">
                            <div class="mb-3">
                                <label class="form-label-modern">Компанія-замовник</label>
                                <input type="text" class="dark-input w-100" @bind="newOrder.CustomerCompany" placeholder="ТОВ 'Приклад'" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label-modern">Контактна особа та телефон</label>
                                <div class="d-flex gap-2">
                                    <input type="text" class="dark-input flex-grow-1" @bind="newOrder.CustomerName" placeholder="Ім'я" />
                                    <input type="text" class="dark-input flex-grow-1" @bind="newOrder.CustomerPhone" placeholder="0501234567" />
                                </div>
                            </div>

                            <hr class="section-divider" />
                            <div class="section-title"><i class="bi bi-box"></i> Характеристики вантажу</div>

                            <div class="mb-3">
                                <label class="form-label-modern">Назва вантажу</label>
                                <input type="text" class="dark-input w-100" @bind="newOrder.CargoName" placeholder="Продукти харчування" />
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label-modern">Вага (т)</label>
                                    <input type="number" step="0.1" class="dark-input w-100" @bind="newOrder.WeightTons" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label-modern">Об'єм (м³)</label>
                                    <input type="number" step="1" class="dark-input w-100" @bind="newOrder.VolumeM3" />
                                </div>
                            </div>

                            <div class="mb-3 d-flex align-items-center">
                                <input type="checkbox" class="form-check-input-dark" id="refCheck" @bind="newOrder.RequiresRefrigerator" style="width: 18px; height: 18px; margin-top: 0;" />
                                <label class="form-check-label-modern" for="refCheck">Потребує рефрижератора 🌡️</label>
                            </div>

                            <hr class="section-divider" />

                            <!-- Мультиточки завантаження -->
                            <div class="mb-3">
                                <label class="form-label-modern">Пункти завантаження</label>
                                @for (int i = 0; i < newOrder.LoadingPoints.Count; i++)
                                {
                                    var index = i;
                                    <div class="d-flex gap-2 mb-2">
                                        <input type="text" class="dark-input flex-grow-1" @bind="newOrder.LoadingPoints[index]" placeholder="Адреса завантаження" />
                                        <button class="btn-modern btn-danger-modern" @onclick="() => newOrder.LoadingPoints.RemoveAt(index)" title="Видалити">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                }
                                <button class="btn-modern" style="background: var(--bg-input); color: var(--text-secondary); border: 1px dashed var(--border-color); width: 100%;"
                                        @onclick="() => newOrder.LoadingPoints.Add(string.Empty)">
                                    <i class="bi bi-plus-circle"></i> Додати точку завантаження
                                </button>
                            </div>

                            <!-- Мультиточки доставки -->
                            <div class="mb-4">
                                <label class="form-label-modern">Пункти доставки</label>
                                @for (int i = 0; i < newOrder.DeliveryPoints.Count; i++)
                                {
                                    var index = i;
                                    <div class="d-flex gap-2 mb-2">
                                        <input type="text" class="dark-input flex-grow-1" @bind="newOrder.DeliveryPoints[index]" placeholder="Адреса доставки" />
                                        <button class="btn-modern btn-danger-modern" @onclick="() => newOrder.DeliveryPoints.RemoveAt(index)" title="Видалити">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                }
                                <button class="btn-modern" style="background: var(--bg-input); color: var(--text-secondary); border: 1px dashed var(--border-color); width: 100%;"
                                        @onclick="() => newOrder.DeliveryPoints.Add(string.Empty)">
                                    <i class="bi bi-plus-circle"></i> Додати точку доставки
                                </button>
                            </div>

                            <button class="btn-modern btn-add w-100" style="height: 48px; font-size: 1rem;" @onclick="CreateOrder">
                                <i class="bi bi-check-circle-fill"></i> Створити замовлення
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Права колонка: Список замовлень та підбір авто -->
                <div class="col-lg-7">
                    <div class="modern-card">
                        <div class="card-header-custom">
                            <h5>
                                <span class="header-icon amber"><i class="bi bi-list-check"></i></span>
                                Активні замовлення
                            </h5>
                            <span class="badge-count">@OrderService.GetAllOrders().Count од.</span>
                        </div>
                        <div class="card-body-custom">
                            @if (!OrderService.GetAllOrders().Any())
                            {
                                <div class="text-center py-5" style="color: var(--text-secondary);">
                                    <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
                                    <p class="mt-3 mb-0">Ще немає створених замовлень</p>
                                </div>
                            }
                            else
                            {
                                @foreach (var order in OrderService.GetAllOrders())
                                {
                                    <div class="modern-card mb-3" style="border-left: 3px solid var(--primary-blue);">
                                        <div class="card-body-custom">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <h6 class="mb-0" style="color: var(--text-primary); font-weight: 700;">
                                                    Замовлення №@order.Id: @order.CargoName
                                                </h6>
                                                <span class="badge-modern badge-amber">@order.Status</span>
                                            </div>

                                            <p class="mb-1" style="color: var(--text-secondary); font-size: 0.85rem;">
                                                <i class="bi bi-building me-1"></i> @order.CustomerCompany (@order.CustomerName, @order.CustomerPhone)
                                            </p>
                                            <p class="mb-2" style="color: var(--text-secondary); font-size: 0.85rem;">
                                                <i class="bi bi-box-seam me-1"></i> @order.WeightTons т | @order.VolumeM3 м³ | Реф: @(order.RequiresRefrigerator ? "Так ❄️" : "Ні")
                                            </p>

                                            <div class="row g-2 mb-3">
                                                <div class="col-sm-6">
                                                    <div style="background: var(--bg-input); padding: 0.6rem; border-radius: 6px; font-size: 0.85rem;">
                                                        <div style="color: var(--text-secondary); font-size: 0.7rem; text-transform: uppercase;">Звідки</div>
                                                        <div style="color: var(--text-primary);">@string.Join(" → ", order.LoadingPoints)</div>
                                                    </div>
                                                </div>
                                                <div class="col-sm-6">
                                                    <div style="background: var(--bg-input); padding: 0.6rem; border-radius: 6px; font-size: 0.85rem;">
                                                        <div style="color: var(--text-secondary); font-size: 0.7rem; text-transform: uppercase;">Куди</div>
                                                        <div style="color: var(--text-primary);">@string.Join(" → ", order.DeliveryPoints)</div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <span style="color: var(--text-secondary); font-size: 0.85rem;">Транспорт:</span>
                                                    <span class="code-text ms-1">@order.AssignedVehiclePlate</span>
                                                </div>
                                                <button class="btn-modern" style="background: rgba(37, 99, 235, 0.15); color: #60a5fa; border: 1px solid rgba(37, 99, 235, 0.3);"
                                                        @onclick="() => SelectOrderForMatching(order)">
                                                    <i class="bi bi-search"></i> Підібрати транспорт
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <!-- Блок підбору автомобілів для обраного замовлення -->
                    @if (selectedOrderForMatching != null)
                    {
                        <div class="modern-card mt-4" style="border: 1px solid var(--primary-blue);">
                            <div class="card-header-custom" style="background: rgba(37, 99, 235, 0.05);">
                                <h5>
                                    <span class="header-icon blue"><i class="bi bi-truck"></i></span>
                                    Рекомендовані авто для замовлення №@selectedOrderForMatching.Id
                                </h5>
                                <button class="btn-modern btn-danger-modern py-1 px-2" @onclick="() => selectedOrderForMatching = null">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                            <div class="card-body-custom">
                                @{
                                    var suitableVehicles = OrderService.GetSuitableVehicles(selectedOrderForMatching, FleetService.GetAllVehicles());
                                }
                                @if (!suitableVehicles.Any())
                                {
                                    <div class="p-3 text-center" style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 8px; color: #f87171;">
                                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                        Не знайдено жодного автомобіля, що відповідає вимогам за вантажопідйомністю, об'ємом чи обладнанням!
                                    </div>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="modern-table">
                                            <thead>
                                                <tr>
                                                    <th>Модель</th>
                                                    <th>Номер</th>
                                                    <th>Вантаж.</th>
                                                    <th>Об'єм</th>
                                                    <th>Реф.</th>
                                                    <th>Дія</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var veh in suitableVehicles)
                                                {
                                                    <tr>
                                                        <td><strong>@veh.BrandModel</strong></td>
                                                        <td><span class="code-text">@veh.LicensePlate</span></td>
                                                        <td>@veh.CapacityTons т</td>
                                                        <td>@veh.VolumeM3 м³</td>
                                                        <td>@(veh.HasRefrigerator ? "✅" : "—")</td>
                                                        <td>
                                                            <button class="btn-modern btn-add py-1 px-3" style="height: auto;"
                                                                    @onclick="() => AssignVehicle(selectedOrderForMatching.Id, veh.LicensePlate)">
                                                                <i class="bi bi-check-lg"></i> Призначити
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </main>
</div>

@code {
    // ===== ВАША ОРИГІНАЛЬНА ЛОГІКА (БЕЗ ЗМІН) =====
    private TransportIn.Models.Order newOrder = new()
    {
        LoadingPoints = new() { "" },
        DeliveryPoints = new() { "" }
    };

    private TransportIn.Models.Order? selectedOrderForMatching;

    protected override void OnInitialized()
    {
        OrderService.OnChange += OnStateChanged;
        FleetService.OnChange += OnStateChanged;
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void CreateOrder()
    {
        if (string.IsNullOrWhiteSpace(newOrder.CustomerCompany) || string.IsNullOrWhiteSpace(newOrder.CargoName))
            return;

        OrderService.AddOrder(newOrder);
        // Скидаємо форму
        newOrder = new()
        {
            LoadingPoints = new() { "" },
            DeliveryPoints = new() { "" }
        };
    }

    private void SelectOrderForMatching(TransportIn.Models.Order order)
    {
        selectedOrderForMatching = order;
    }

    private void AssignVehicle(int orderId, string plate)
    {
        OrderService.AssignVehicle(orderId, plate);
        selectedOrderForMatching = null;
    }

    private void Logout()
    {
        AuthService.Logout();
        Navigation.NavigateTo("/");
    }

    public void Dispose()
    {
        OrderService.OnChange -= OnStateChanged;
        FleetService.OnChange -= OnStateChanged;
    }
}