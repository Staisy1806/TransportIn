@page "/driver-dashboard"
@rendermode InteractiveServer
@inject TransportIn.Services.AuthService AuthService
@inject TransportIn.Services.EmergencyService EmergencyService
@inject TransportIn.Services.OrderService OrderService
@inject NavigationManager Navigation
@implements IDisposable

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Кабінет Водія: @AuthService.CurrentUser?.FullName</h2>
        <button class="btn btn-outline-danger btn-sm" @onclick="Logout">Вийти</button>
    </div>

    <div class="alert @GetAlertClass(EmergencyService.CurrentEmergency) mb-4 shadow-sm">
        <h4 class="alert-heading">
            ⚠️ Статус у місті: <strong>@EmergencyService.CurrentEmergency</strong>
        </h4>
        <p class="mb-0">
            Дотримуйтесь інструкцій логістичного центру та правил безпеки для цього режиму.
        </p>
    </div>

    <div class="row">
        <div class="col-md-7">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">🚚 Мої призначені замовлення</h5>
                </div>

                <div class="card-body">
                    @if (orders.Count == 0)
                    {
                        <p class="text-muted">Наразі немає активних призначень.</p>
                    }
                    else
                    {
                        @foreach (var order in orders)
                        {
                            <div class="card mb-3 border-secondary">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        Замовлення №@order.Id: @order.CargoName
                                    </h5>

                                    <p class="mb-1">
                                        <strong>Замовник:</strong>
                                        @order.CustomerCompany (@order.CustomerName,
                                        тел: @order.CustomerPhone)
                                    </p>

                                    <p class="mb-1">
                                        <strong>Параметри:</strong>
                                        Вага: @order.WeightTons т |
                                        Об'єм: @order.VolumeM3 м³
                                    </p>

                                    <p class="mb-1 text-primary">
                                        <strong>Звідки:</strong>
                                        @string.Join(" ➔ ", order.LoadingPoints)
                                    </p>

                                    <p class="mb-2 text-success">
                                        <strong>Куди:</strong>
                                        @string.Join(" ➔ ", order.DeliveryPoints)
                                    </p>

                                    <p class="mb-2">
                                        <strong>Статус виконання:</strong>
                                        <span class="badge bg-info text-dark">
                                            @order.Status
                                        </span>
                                    </p>

                                    <div class="btn-group-sm mt-2" role="group">
                                        <button class="btn btn-outline-secondary"
                                                @onclick='() => UpdateOrderStatus(order, "Прибув на завантаження")'>
                                            Прибув на завантаження
                                        </button>

                                        <button class="btn btn-outline-primary"
                                                @onclick='() => UpdateOrderStatus(order, "В дорозі / Виконання")'>
                                            В дорозі
                                        </button>

                                        <button class="btn btn-outline-success"
                                                @onclick='() => UpdateOrderStatus(order, "Доставлено / Завершено")'>
                                            Доставлено
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">🚨 Повідомити про проблему</h5>
                </div>

                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Тип проблеми</label>
                        <select class="form-select" @bind="problemType">
                            <option value="ДТП / Перекриття дороги (Адмін)">
                                ДТП / Проблема на дорозі
                            </option>
                            <option value="Клієнт не виходить на зв'язок (Менеджер)">
                                Проблема зі стороною клієнта
                            </option>
                            <option value="Технічна несправність авто">
                                Технічна поломка автомобіля
                            </option>
                            <option value="Погіршення самопочуття">
                                Проблеми зі здоров'ям
                            </option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Опис проблеми</label>
                        <textarea class="form-control"
                                  rows="3"
                                  @bind="problemDescription"
                                  placeholder="Опишіть ситуацію...">
                        </textarea>
                    </div>

                    <button class="btn btn-danger w-100"
                            @onclick="SendProblemReport">
                        Надіслати диспетчеру
                    </button>

                    @if (reportSent)
                    {
                        <div class="alert alert-success mt-3 mb-0 py-2">
                            Повідомлення успішно надіслано відповідальній стороні!
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<TransportIn.Models.Order> orders = new();

    private string problemType = "ДТП / Перекриття дороги (Адмін)";
    private string problemDescription = "";
    private bool reportSent = false;

    protected override async Task OnInitializedAsync()
    {
        EmergencyService.OnChange += OnEmergencyChanged;

        orders = await OrderService.GetAllOrdersAsync();
    }

    private void OnEmergencyChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private string GetAlertClass(string status) => status switch
    {
        "Повітряна тривога" => "alert-danger",
        "Ожеледиця" => "alert-warning",
        "Потоп / Буря" => "alert-info",
        _ => "alert-success"
    };

    private async Task UpdateOrderStatus(
        TransportIn.Models.Order order,
        string newStatus)
    {
        order.Status = newStatus;

        await OrderService.UpdateOrderAsync(order);

        orders = await OrderService.GetAllOrdersAsync();
    }

    private void SendProblemReport()
    {
        if (string.IsNullOrWhiteSpace(problemDescription))
            return;

        reportSent = true;
        problemDescription = "";
    }

    private void Logout()
    {
        AuthService.Logout();
        Navigation.NavigateTo("/");
    }

    public void Dispose()
    {
        EmergencyService.OnChange -= OnEmergencyChanged;
    }
}
