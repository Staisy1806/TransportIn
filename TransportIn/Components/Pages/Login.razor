@page "/"
@rendermode InteractiveServer
@inject TransportIn.Services.AuthService AuthService
@inject NavigationManager Navigation

<div class="login-page">
    <div class="login-card">
        <!-- Заголовок -->
        <div class="login-header">
            <i class="bi bi-truck-front-fill"></i>
            <h2>TransportIn</h2>
            <p>Логістична система управління</p>
        </div>

        <!-- Повідомлення про помилку -->
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="login-alert-danger">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @errorMessage
            </div>
        }

        <!-- Форма входу -->
        <div>
            <div class="mb-3">
                <label class="form-label-modern">Логін</label>
                <div class="input-group-modern">
                    <i class="bi bi-person"></i>
                    <input type="text" @bind="username" placeholder="admin, manager або driver" autocomplete="username" />
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label-modern">Пароль</label>
                <div class="input-group-modern">
                    <i class="bi bi-lock"></i>
                    <input type="password" @bind="password" placeholder="••••••" autocomplete="current-password" />
                </div>
            </div>

            <button class="btn-login" @onclick="HandleLogin">
                <i class="bi bi-box-arrow-in-right"></i> Увійти в систему
            </button>
        </div>

        <!-- Підказка для тестування -->
        <div class="login-hint">
            <i class="bi bi-info-circle me-1"></i>
            Швидкий вхід для тесту:<br>
            <b>admin</b> / 123 &nbsp;|&nbsp; <b>manager</b> / 123 &nbsp;|&nbsp; <b>driver</b> / 123
        </div>
    </div>
</div>

@code {
    private string username = "";
    private string password = "";
    private string errorMessage = "";

    private void HandleLogin()
    {
        var user = AuthService.Login(username, password);
        if (user == null)
        {
            errorMessage = "Невірний логін або пароль!";
        }
        else
        {
            errorMessage = "";
            switch (user.Role)
            {
                case TransportIn.Models.UserRole.Admin:
                    Navigation.NavigateTo("/admin-dashboard");
                    break;
                case TransportIn.Models.UserRole.Manager:
                    Navigation.NavigateTo("/manager-dashboard");
                    break;
                case TransportIn.Models.UserRole.Driver:
                    Navigation.NavigateTo("/driver-dashboard");
                    break;
            }
        }
    }
}