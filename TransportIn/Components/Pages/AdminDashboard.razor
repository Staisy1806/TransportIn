@page "/admin-dashboard"
@rendermode InteractiveServer
@inject TransportIn.Services.AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject TransportIn.Services.EmergencyService EmergencyService

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Кабінет Адміністратора: @AuthService.CurrentUser?.FullName</h2>
        <button class="btn btn-outline-danger btn-sm" @onclick="Logout">Вийти</button>
    </div>

    <!-- Вкладки (Tabs) -->
    <ul class="nav nav-tabs" id="adminTabs" role="tablist">
        <li class="nav-item">
            <button class="nav-link @(activeTab == 1 ? "active" : "")" @onclick="() => activeTab = 1">Працівники</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == 2 ? "active" : "")" @onclick="() => activeTab = 2">Мапа міста та Форс-мажори</button>
        </li>
    </ul>

    <div class="tab-content border border-top-0 p-4 bg-white shadow-sm">
        @if (activeTab == 1)
        {
            <!-- Вкладка 1: Реєстрація працівників -->
            <h4>Реєстрація нового працівника</h4>
            <div class="row g-3 mb-4" style="max-width: 600px;">
                <div class="col-md-6">
                    <label>Логін:</label>
                    <input type="text" class="form-control" @bind="newUsername" />
                </div>
                <div class="col-md-6">
                    <label>Пароль:</label>
                    <input type="text" class="form-control" @bind="newPassword" />
                </div>
                <div class="col-md-6">
                    <label>ПІБ:</label>
                    <input type="text" class="form-control" @bind="newFullName" />
                </div>
                <div class="col-md-6">
                    <label>Телефон:</label>
                    <input type="text" class="form-control" @bind="newPhone" />
                </div>
                <div class="col-md-12">
                    <label>Роль:</label>
                    <select class="form-select" @bind="newRole">
                        <option value="@TransportIn.Models.UserRole.Manager">Менеджер</option>
                        <option value="@TransportIn.Models.UserRole.Driver">Водій</option>
                        <option value="@TransportIn.Models.UserRole.Admin">Адмін</option>
                    </select>
                </div>
                <div class="col-md-12">
                    <button class="btn btn-success" @onclick="RegisterNewEmployee">Зареєструвати працівника</button>
                </div>
            </div>

            <hr />
            <h5>Список усіх працівників</h5>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>ПІБ</th>
                        <th>Логін</th>
                        <th>Роль</th>
                        <th>Телефон</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in AuthService.GetAllUsers())
                    {
                        <tr>
                            <td>@user.FullName</td>
                            <td>@user.Username</td>
                            <td><span class="badge bg-secondary">@user.Role</span></td>
                            <td>@user.Phone</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else if (activeTab == 2)
        {
            <!-- Вкладка 2: Мапа з фільтрами та форс-мажорами -->
            <h4>Моніторинг транспорту та Керування ситуацією</h4>

            <!-- Панель чекбоксів (фільтрів) -->
            <div class="mb-3 p-2 bg-light rounded border d-flex gap-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="chkWarehouses" @bind="showWarehouses" @bind:after="RefreshMapMarkers" />
                    <label class="form-check-label fw-bold" for="chkWarehouses">🏢 Показати склади</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="chkDrivers" @bind="showDrivers" @bind:after="RefreshMapMarkers" />
                    <label class="form-check-label fw-bold" for="chkDrivers">🚚 Показати водіїв (машини)</label>
                </div>
            </div>

            <div class="row">
                <div class="col-md-8">
                    <div id="map" style="height: 450px; width: 100%; border-radius: 8px;" class="shadow-sm"></div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-light">
                        <div class="card-body">
                            <h5 class="card-title text-danger">Панель надзвичайних ситуацій</h5>
                            <p class="text-muted small">Зміна налаштувань миттєво блокує або змінює маршрути водіїв.</p>

                            <div class="d-grid gap-2">
                                <button class="btn btn-danger" @onclick='() => ToggleEmergency("Повітряна тривога")'>🔴 Увімкнути Тривогу</button>
                                <button class="btn btn-warning" @onclick='() => ToggleEmergency("Ожеледиця")'>🟡 Ожеледиця (Швидкість знижено)</button>
                                <button class="btn btn-info text-white" @onclick='() => ToggleEmergency("Потоп / Буря")'>🔵 Потоп / Буря</button>
                                <button class="btn btn-outline-success" @onclick='() => ToggleEmergency("Нормальний режим")'>🟢 Зняти всі обмеження</button>
                            </div>

                            <hr />
                            <p class="small"><b>Активний статус:</b> <span class="text-danger">@currentEmergency</span></p>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private int activeTab = 1;

    // Поля форми нового юзера
    private string newUsername = "";
    private string newPassword = "";
    private string newFullName = "";
    private string newPhone = "";
    private TransportIn.Models.UserRole newRole = TransportIn.Models.UserRole.Driver;
    private string currentEmergency = "Нормальний режим";

    // Стан фільтрів на мапі
    private bool showWarehouses = true;
    private bool showDrivers = true;

    // Модель для об'єктів на мапі
    private class MapItemDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Type { get; set; } = ""; // "Склад" або "Водій"
        public double Lat { get; set; }
        public double Lng { get; set; }
        public string Status { get; set; } = "";
    }

    // Тестові дані (склади та водії)
    private List<MapItemDto> allMapItems = new()
    {
        new MapItemDto { Id = 1, Name = "Склад №1 (Центральний)", Type = "Склад", Lat = 50.4501, Lng = 30.5234, Status = "Працює в штатному режимі" },
        new MapItemDto { Id = 2, Name = "Склад №2 (Північний логістичний хаб)", Type = "Склад", Lat = 50.4801, Lng = 30.4834, Status = "Обмежено через тривогу" },
        new MapItemDto { Id = 3, Name = "Бус Mercedes (Водій: Іван)", Type = "Водій", Lat = 50.4551, Lng = 30.5334, Status = "В дорозі до отримувача" },
        new MapItemDto { Id = 4, Name = "Рефрижератор MAN (Водій: Петро)", Type = "Водій", Lat = 50.4401, Lng = 30.5134, Status = "Завантаження на складі" }
    };

    private bool mapInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (activeTab == 2)
        {
            if (!mapInitialized)
            {
                // Ініціалізуємо мапу один раз при переході на вкладку
                await JS.InvokeVoidAsync("leafletMapFunctions.initMap", "map", 50.4501, 30.5234, 13);
                mapInitialized = true;
            }
            // Оновлюємо маркери з урахуванням поточних фільтрів
            await RefreshMapMarkers();
        }
        else
        {
            mapInitialized = false; // Скидаємо прапорець, якщо вийшли з вкладки
        }
    }

    private async Task RefreshMapMarkers()
    {
        // Фільтруємо дані залежно від стану чекбоксів
        var filteredItems = allMapItems.Where(i =>
            (i.Type == "Склад" && showWarehouses) ||
            (i.Type == "Водій" && showDrivers)
        ).ToList();

        await JS.InvokeVoidAsync("leafletMapFunctions.updateMarkers", filteredItems);
    }

    private void RegisterNewEmployee()
    {
        if (!string.IsNullOrEmpty(newUsername) && !string.IsNullOrEmpty(newPassword))
        {
            AuthService.RegisterUser(newUsername, newPassword, newRole, newFullName, newPhone);
            newUsername = newPassword = newFullName = newPhone = "";
        }
    }

    private void ToggleEmergency(string status)
    {
        currentEmergency = status;
        EmergencyService.CurrentEmergency = status; // Вот этого не хватало! Обновляем глобально
    }

    private void Logout()
    {
        AuthService.Logout();
        Navigation.NavigateTo("/");
    }
}